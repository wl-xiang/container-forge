FROM {{BASE_IMAGE}}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

{{APT_INSTALL_BLOCK}}

{{PIP_INSTALL_BLOCK}}

{{REQUIREMENTS_BLOCK}}

{{LABELS_BLOCK}}

{{NON_ROOT_BLOCK}}

WORKDIR /workspace

# 基础镜像自检：必须包含 /bin/bash（见 README「风险与缓解」）
RUN test -x /bin/bash || { echo 'ERROR: base image does not contain /bin/bash'; exit 1; }

ENTRYPOINT ["/bin/bash"]
CMD ["-l"]
